# NextAuth
NEXTAUTH_SECRET=replace-with-a-long-random-string
NEXTAUTH_URL=http://localhost:3000

# Общий пароль для входа в CRM: любой, кто его введёт на странице входа, попадает внутрь.
# На Render задаётся в Environment. Если не задан — вход закрыт для всех.
DEMO_COORDINATOR_PASSWORD=change-me

# Заполняется на Этапах 1, 3 и 4
MONGODB_URI=
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
# Gemini 1.5 Flash из плана уже отключена Google (модели поколения 1.0/1.5
# полностью выведены из эксплуатации). По умолчанию код использует
# gemini-3.8-flash — актуальную модель на момент написания; проверяйте
# https://ai.google.dev/gemini-api/docs/deprecations, если потребуется другая.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Секрет для защиты /api/cron/follow-up от чужих вызовов (см. README)
CRON_SECRET=
# Необязательные запасные модели, которые используются по очереди, если основная модель недоступна (например, 503 или 429).
GEMINI_MODEL_FALLBACK_1=
GEMINI_MODEL_FALLBACK_2=

# Необязательно: окно, в которое бот зовёт пациента на звонок (lib/call-window.ts).
# Час — по часовому поясу BOT_TIMEZONE, начало включительно, конец нет.
# По умолчанию Asia/Dushanbe, 12:00–17:00. Одинаковые значения = приглашения выключены.
BOT_TIMEZONE=Asia/Dushanbe
CALL_WINDOW_START_HOUR=12
CALL_WINDOW_END_HOUR=17

# Необязательно: перед ответом бот отмечает сообщения пациента «прочитанными»
# (синие галочки), потом «печатает…». По умолчанию включено. off — выключить
# (например, чтобы непрочитанные чаты оставались непрочитанными на телефоне).
WHATSAPP_MARK_READ=on

# Необязательно: названия агентства-отправителя через запятую; упоминание в плане даёт жёлтое предупреждение (раздел «Планы»)
PLAN_SENDER_NAMES=

# Необязательно: автоответ в Instagram (комментарии и Direct), раздел «Instagram» в README.
# Секреты задаются только в окружении сервиса (Render), не в репозитории.
# Долгоживущий токен из консоли Meta (шаг «Generate access tokens»). Живёт 60 дней, бот продлевает его сам.
INSTAGRAM_ACCESS_TOKEN=
# App secret приложения Instagram: по нему проверяется подпись вебхуков (X-Hub-Signature-256).
INSTAGRAM_APP_SECRET=
# Любая строка; должна совпадать с полем «Verify token» в консоли Meta при подключении вебхука.
INSTAGRAM_VERIFY_TOKEN=
# on — отвечать (по умолчанию); off — не отвечать, но вебхуки принимаются.
INSTAGRAM_AUTOREPLY=on
# Версия Graph API (по умолчанию v23.0).
INSTAGRAM_GRAPH_VERSION=v23.0
# Номер WhatsApp для ответов (по умолчанию +992005507777).
INSTAGRAM_WHATSAPP_NUMBER=+992005507777
# Часы, в течение которых не приглашаем того же человека в Direct повторно (по умолчанию 12).
INSTAGRAM_DM_COOLDOWN_HOURS=12
# Часы, в течение которых не отвечаем на комментарии того же человека повторно (по умолчанию 6).
INSTAGRAM_COMMENT_COOLDOWN_HOURS=6
# on — паузы перед ответом, как у живого человека (по умолчанию); off — без пауз.
INSTAGRAM_REPLY_DELAY=on
# on — в Direct после первого приглашения отвечает ИИ (по умолчанию); off — только шаблонное приглашение, как раньше.
INSTAGRAM_AI_REPLIES=on
# Сколько ответов ИИ получает один человек за 24 часа (по умолчанию 30).
INSTAGRAM_AI_DAILY_LIMIT=30
